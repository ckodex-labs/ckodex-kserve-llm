{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "type": "datasource",
      "pluginId": "tempo"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "CKodex KServe LLM Operator — token throughput, GPU utilization, latency, chargeback, and security",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Chargeback — Tokens & GPU-Seconds",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (ckodex_tenant_id, ckodex_model) (increase(ckodex_tenant_tokens_consumed_total[$__rate_interval]))",
          "legendFormat": "{{ckodex_tenant_id}} / {{ckodex_model}}",
          "refId": "A"
        }
      ],
      "title": "Token Throughput by Tenant / Model",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (ckodex_tenant_id, ckodex_model) (increase(ckodex_tenant_active_gpu_seconds_total[$__rate_interval]))",
          "legendFormat": "{{ckodex_tenant_id}} / {{ckodex_model}}",
          "refId": "A"
        }
      ],
      "title": "Active GPU-Seconds by Tenant / Model",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Inference Latency",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "fixedColor": "#5794F2", "mode": "fixed" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [{ "id": "color", "value": { "fixedColor": "#56A64B", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ckodex:inference_latency_p99",
          "legendFormat": "P99 {{model}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ckodex:inference_latency_p50",
          "legendFormat": "P50 {{model}}",
          "refId": "B"
        }
      ],
      "title": "Inference Latency P50 / P99",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "calculate": true,
        "cellGap": 1,
        "yAxis": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ckodex:gpu_utilization_p95",
          "legendFormat": "{{ckodex_tenant_id}} / {{ckodex_model}}",
          "refId": "A"
        }
      ],
      "title": "GPU Utilization P95 Heatmap",
      "type": "heatmap"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Scale-to-Zero Timeline",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 19 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kube_deployment_status_replicas_available{label_app_kubernetes_io_managed_by=\"ckodex-kserve-llm-operator\"}",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "title": "Available Replicas per Deployment (Scale-to-Zero visible at 0)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 103,
      "title": "Operator Reconcile Health",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.9 },
            { "color": "green", "value": 0.99 }
          ] }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 27 },
      "id": 6,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg(ckodex:reconcile_success_rate)",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ],
      "title": "Reconcile Success Rate",
      "type": "gauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 27 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (model, le) (rate(ckodex_reconcile_duration_seconds_bucket[5m])))",
          "legendFormat": "P99 {{model}}",
          "refId": "A"
        }
      ],
      "title": "Reconcile Duration P99",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "Logs — OTel Correlation (Loki + Tempo)",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{app=\"ckodex-llm\", tenant_id=~\"$tenant_id\"} |= \"\" | json | trace_id != \"\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Inference Logs with Trace IDs (click trace_id → Tempo)",
      "type": "logs"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ckodex", "llm", "inference", "chargeback", "otel"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(ckodex_tenant_tokens_consumed_total, ckodex_tenant_id)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "tenant_id",
        "options": [],
        "query": {
          "query": "label_values(ckodex_tenant_tokens_consumed_total, ckodex_tenant_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Tenant"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(ckodex_tenant_tokens_consumed_total, ckodex_model)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "model",
        "query": {
          "query": "label_values(ckodex_tenant_tokens_consumed_total, ckodex_model)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Model"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CKodex LLM Operator — Chargeback & Performance",
  "uid": "ckodex-llm-operator",
  "version": 1
}
