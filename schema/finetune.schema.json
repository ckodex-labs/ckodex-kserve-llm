{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckodex.io/schemas/aipack/v0.1.1/finetune.schema.json",
  "title": "AIPack FineTune (A3)",
  "description": "AIPACK-SPEC v0.1.1 §3.3 — FineTune artifact (A3). Full fine-tuned model weights derived from a BaseModel.",
  "type": "object",
  "required": ["kind", "source", "fineTune"],
  "properties": {
    "kind":   { "const": "FineTune" },
    "family": { "const": "model" },
    "source": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref":      { "$ref": "agent.schema.json#/$defs/DigestRef" },
        "registry": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fineTune": {
      "type": "object",
      "required": ["baseRef"],
      "properties": {
        "baseRef":       { "$ref": "agent.schema.json#/$defs/DigestRef", "description": "Digest ref to the BaseModel used as the starting checkpoint." },
        "datasetRef":    { "$ref": "agent.schema.json#/$defs/DigestRef", "description": "Digest ref to the Dataset artifact used for fine-tuning." },
        "method":        { "type": "string", "enum": ["sft","dpo","rlhf","ppo","grpo","other"] },
        "epochs":        { "type": "number", "minimum": 0 },
        "learningRate":  { "type": "number", "minimum": 0 },
        "batchSize":     { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "attestation": { "$ref": "agent.schema.json#/$defs/AIPackAttestation" }
  },
  "additionalProperties": true
}
