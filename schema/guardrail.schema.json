{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckodex.io/schemas/aipack/v0.1.1/guardrail.schema.json",
  "title": "AIPack Guardrail (A8)",
  "description": "AIPACK-SPEC v0.1.1 §3.3 — Guardrail artifact (A8). Input or output safety filter with coverage and FPR attestation.",
  "type": "object",
  "required": ["kind", "source"],
  "properties": {
    "kind":   { "const": "Guardrail" },
    "family": { "const": "control" },
    "source": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref":      { "$ref": "agent.schema.json#/$defs/DigestRef" },
        "registry": { "type": "string" }
      },
      "additionalProperties": false
    },
    "guardrail": {
      "type": "object",
      "properties": {
        "position":    { "type": "string", "enum": ["input","output","both"] },
        "categories":  { "type": "array", "items": { "type": "string" } },
        "threshold":   { "type": "number", "minimum": 0, "maximum": 1 },
        "action":      { "type": "string", "enum": ["block","flag","redact","passthrough"] }
      },
      "additionalProperties": true
    },
    "attestation": { "$ref": "agent.schema.json#/$defs/AIPackAttestation" }
  },
  "additionalProperties": true
}
