{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckodex.io/schemas/aipack/v0.1.1/lora.schema.json",
  "title": "AIPack LoRA (A2)",
  "description": "AIPACK-SPEC v0.1.1 §3.3 — LoRA adapter artifact (A2). Low-Rank Adaptation weights that attach to a BaseModel at serving time.",
  "type": "object",
  "required": ["kind", "source", "lora"],
  "properties": {
    "kind":   { "const": "LoRA" },
    "family": { "const": "model" },
    "source": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref":      { "$ref": "agent.schema.json#/$defs/DigestRef" },
        "registry": { "type": "string" }
      },
      "additionalProperties": false
    },
    "lora": {
      "type": "object",
      "required": ["baseRef"],
      "properties": {
        "baseRef":   { "$ref": "agent.schema.json#/$defs/DigestRef", "description": "Digest ref to the BaseModel this adapter was trained on (AIPACK-COMPAT-001)." },
        "rank":      { "type": "integer", "minimum": 1 },
        "alpha":     { "type": "number" },
        "targetModules": { "type": "array", "items": { "type": "string" } },
        "mergedInto": { "type": "string", "description": "If set, this LoRA has been merged into its base and the merged ref is here." }
      },
      "additionalProperties": true
    },
    "attestation": { "$ref": "agent.schema.json#/$defs/AIPackAttestation" }
  },
  "additionalProperties": true
}
