{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckodex.io/schemas/aipack/v0.1.1/skill.schema.json",
  "title": "AIPack Skill (A4)",
  "description": "AIPACK-SPEC v0.1.1 §3.3 — Skill artifact (A4). A packaged agentic capability (code + manifest) that agents can invoke.",
  "type": "object",
  "required": ["kind", "source"],
  "properties": {
    "kind":   { "const": "Skill" },
    "family": { "const": "capability" },
    "source": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref":      { "$ref": "agent.schema.json#/$defs/DigestRef" },
        "registry": { "type": "string" }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "entrypoint":    { "type": "string" },
        "runtime":       { "type": "string", "enum": ["python","nodejs","wasm","binary"] },
        "capabilities":  { "type": "array", "items": { "type": "string" } },
        "permissions":   { "type": "array", "items": { "type": "string" } },
        "sandboxed":     { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "attestation": { "$ref": "agent.schema.json#/$defs/AIPackAttestation" }
  },
  "additionalProperties": true
}
